player_progression {
  max_level = 100
  base_skill_points = 10
  skill_points_per_10_levels = 1
  
  -- XP base por completar misión
  mission_base_xp = 100
  
  -- Multiplicadores por dificultad
  difficulty_multipliers {
    easy = 1.0
    normal = 1.5
    hard = 2.0
    hardmode = 3.0
  }
  
  -- Bonos por rendimiento
  performance_bonuses {
    speed_bonus_threshold = 600  -- completar en <10min
    speed_bonus_xp = 50
    no_death_bonus = 100
    perfect_run_bonus = 150  -- sin muertes + rápido
  }
}

